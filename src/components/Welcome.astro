---
import PaperDot from "@/components/PaperDot";
import WelcomeText from "@/components/WelcomeText";
---

<section class="bg-background relative z-0 min-h-svh overflow-hidden">
    <div
        aria-hidden="true"
        class="absolute inset-y-0 right-0 aspect-[1419/1108] max-w-none [mask-image:linear-gradient(to_right,transparent_0%,black_18%)] select-none"
    >
        <PaperDot client:load />
    </div>

    <div
        aria-hidden="true"
        class="from-background via-background/90 to-background/25 absolute inset-0 bg-linear-to-r sm:hidden"
    >
    </div>

    <img
        src="/logo.png"
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        class="pointer-events-none absolute -bottom-58 -left-[2.5rem] z-1 hidden w-[64rem] rotate-12 opacity-[0.03] mix-blend-multiply select-none sm:-bottom-58 sm:-left-[11rem] sm:block sm:w-[64rem] lg:-bottom-[32rem] lg:-left-[28rem] lg:w-[75rem]"
    />

    <div
        aria-hidden="true"
        class="paper-grain pointer-events-none absolute inset-0 z-2 select-none"
    >
    </div>

    <div
        class="relative z-10 mx-auto flex min-h-svh w-full max-w-360 items-center px-6 sm:px-10 lg:px-12 xl:px-16"
    >
        <WelcomeText client:load />
    </div>

    <div
        aria-hidden="true"
        class="to-background pointer-events-none absolute right-0 bottom-0 left-0 z-10 h-32 bg-gradient-to-b from-transparent sm:h-40"
    >
    </div>

    <script>
        import { animate } from "motion";

        const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)"
        ).matches;
        const watermark = document.querySelector(".hero-watermark");

        if (watermark && !prefersReducedMotion) {
            (watermark as HTMLElement).style.opacity = "0";
            (watermark as HTMLElement).style.transform =
                "rotate(12deg) scale(1.02)";

            animate(
                watermark,
                { opacity: 0.03, transform: "rotate(12deg) scale(1)" },
                {
                    duration: 1.4,
                    delay: 0.2,
                    ease: [0.22, 1, 0.36, 1],
                }
            );
        }
    </script>
</section>
