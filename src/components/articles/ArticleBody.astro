---
import type { Article, ArticleBlock } from "@/data/articles";

interface Props {
    article: Article;
}

const { article } = Astro.props;
---

<div class="article-body max-w-[70ch]">
    {
        article.content.map((block: ArticleBlock) => {
            if (block.type === "heading") {
                const Tag = block.level === 2 ? "h2" : "h3";
                return (
                    <Tag id={block.id} data-toc-heading class="scroll-mt-32">
                        {block.text}
                    </Tag>
                );
            }

            if (block.type === "quote") {
                return (
                    <blockquote class="article-pull-quote">
                        <span
                            class="article-pull-quote-bar"
                            aria-hidden="true"
                        />
                        {block.text}
                    </blockquote>
                );
            }

            if (block.type === "image") {
                return (
                    <figure class="article-figure">
                        <img
                            src={block.src}
                            alt={block.alt}
                            loading="lazy"
                            decoding="async"
                        />
                        {block.caption && (
                            <figcaption>{block.caption}</figcaption>
                        )}
                    </figure>
                );
            }

            return <p>{block.text}</p>;
        })
    }
</div>

<style>
    .article-body {
        color: #1a1a1a;
        font-size: 19px;
        line-height: 1.7;
    }

    .article-body :global(p) {
        margin-bottom: 1.6em;
        max-width: 68ch;
    }

    .article-body :global(h2) {
        color: var(--color-text);
        font-weight: 500;
        font-size: 1.5rem;
        line-height: 1.3;
        letter-spacing: -0.01em;
        margin-top: 3em;
        margin-bottom: 1em;
    }

    .article-body :global(h3) {
        color: var(--color-text);
        font-weight: 500;
        font-size: 1.2rem;
        line-height: 1.4;
        margin-top: 2.4em;
        margin-bottom: 0.9em;
    }

    .article-body :global(.article-pull-quote) {
        position: relative;
        color: var(--color-text);
        font-size: 1.4rem;
        line-height: 1.5;
        font-weight: 400;
        letter-spacing: -0.01em;
        margin: 2.2em 0;
        padding: 0.2em 0 0.2em 1.5rem;
        max-width: 56ch;
    }

    .article-body :global(.article-pull-quote-bar) {
        position: absolute;
        top: 0;
        left: 0;
        width: 2px;
        height: 100%;
        background: var(--color-accent);
        transform-origin: top;
        transform: scaleY(1);
    }

    .article-body :global(.article-figure) {
        margin: 2.6em 0;
        max-width: 68ch;
    }

    .article-body :global(.article-figure img) {
        width: 100%;
        border: 1px solid var(--color-border);
    }

    .article-body :global(.article-figure figcaption) {
        color: var(--color-text-secondary);
        font-size: 0.8rem;
        margin-top: 0.75rem;
    }

    @media (max-width: 640px) {
        .article-body {
            font-size: 18px;
        }

        .article-body :global(.article-pull-quote) {
            font-size: 1.2rem;
        }
    }
</style>

<script>
    import { inView, animate } from "motion";

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;

    function initPullQuoteReveal() {
        const quotes = document.querySelectorAll(".article-pull-quote");
        if (!quotes.length) return;

        quotes.forEach((quote) => {
            const bar = quote.querySelector(".article-pull-quote-bar");

            if (prefersReducedMotion) {
                if (quote instanceof HTMLElement) quote.style.opacity = "1";
                if (bar instanceof HTMLElement)
                    bar.style.transform = "scaleY(1)";
                return;
            }

            if (quote instanceof HTMLElement) {
                quote.style.opacity = "0";
                quote.style.transform = "translateY(14px)";
                quote.style.willChange = "transform, opacity";
            }
            if (bar instanceof HTMLElement) {
                bar.style.transform = "scaleY(0)";
                bar.style.willChange = "transform";
            }

            inView(
                quote,
                () => {
                    const textAnimation = animate(
                        quote,
                        { opacity: 1, y: 0 },
                        { duration: 0.6, ease: [0.22, 1, 0.36, 1] }
                    );
                    textAnimation.then(() => {
                        if (quote instanceof HTMLElement)
                            quote.style.willChange = "auto";
                    });

                    if (bar) {
                        const barAnimation = animate(
                            bar,
                            { transform: "scaleY(1)" },
                            {
                                duration: 0.5,
                                delay: 0.1,
                                ease: [0.22, 1, 0.36, 1],
                            }
                        );
                        barAnimation.then(() => {
                            if (bar instanceof HTMLElement)
                                bar.style.willChange = "auto";
                        });
                    }
                },
                { margin: "0px 0px -15% 0px", amount: 0.4 }
            );
        });
    }

    initPullQuoteReveal();
</script>
