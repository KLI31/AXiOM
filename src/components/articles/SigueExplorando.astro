---
import ArticleThumbnail from "@/components/articles/ArticleThumbnail";
import type { Article } from "@/data/articles";

interface Props {
    articles: Article[];
}

const { articles } = Astro.props;
---

<section class="border-border border-t">
    <div
        class="mx-auto w-full max-w-360 px-6 py-14 sm:px-10 lg:px-12 lg:py-16 xl:px-16"
    >
        <h2
            class="text-text mb-8 text-xs font-medium tracking-[0.2em] uppercase"
        >
            Sigue explorando
        </h2>
        <ul
            class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4"
        >
            {
                articles.slice(0, 4).map((article) => (
                    <li>
                        <a
                            href={`/articles/${article.slug}`}
                            class="group flex flex-col"
                        >
                            <div class="aspect-4/3 w-full overflow-hidden">
                                <ArticleThumbnail
                                    article={article}
                                    client:visible
                                    className="h-full w-full"
                                />
                            </div>
                            <div class="mt-4 flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <span class="text-accent mb-2 block text-xs font-medium tracking-widest uppercase">
                                        {article.category}
                                    </span>
                                    <h3 class="text-text group-hover:text-accent mb-2 text-base leading-snug font-medium transition-colors">
                                        {article.title}
                                    </h3>
                                    <span class="text-text-secondary text-xs">
                                        {article.readingTime}
                                    </span>
                                </div>
                                <span
                                    aria-hidden="true"
                                    class="text-text-secondary/60 group-hover:text-text shrink-0 text-lg transition-all duration-300 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                >
                                    ↗
                                </span>
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
