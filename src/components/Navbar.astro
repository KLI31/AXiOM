---
const navLinks = [
    { label: "Artículos", href: "/articles" },
    { label: "Sobre mí", href: "/about" },
];
---

<header
    class="site-header pointer-events-none fixed inset-x-0 top-0 z-50 h-28"
    style="opacity: 0; transform: translateY(-12px);"
>
    <div
        aria-hidden="true"
        class="site-header-bg pointer-events-none absolute inset-0 bg-linear-to-b from-[#f6f1ec] via-[#f6f1ec]/75 to-transparent"
    >
    </div>

    <nav
        class="pointer-events-auto relative mx-auto flex h-20 max-w-360 items-center justify-between px-6 sm:px-10 lg:px-12 xl:px-16"
        aria-label="Navegación principal"
    >
        <a href="/" class="navbar-logo flex items-center gap-2.5">
            <img
                src="/logo.png"
                width="50"
                height="50"
                alt=""
                class="mix-blend-multiply"
            />
            <span
                class="navbar-logo-text mb-1 flex text-base font-semibold tracking-[0.24em] text-stone-900 uppercase"
            >
                {
                    "AXIOM".split("").map((letter) => (
                        <span class="navbar-logo-letter-mask inline-block overflow-hidden">
                            <span class="navbar-logo-letter inline-block">
                                {letter}
                            </span>
                        </span>
                    ))
                }
            </span>
        </a>

        <ul class="hidden items-center gap-x-9 sm:flex">
            {
                navLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="navbar-link border-b border-transparent py-2 text-sm font-medium text-stone-700 transition-colors duration-200 hover:border-stone-900 hover:text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stone-900"
                        >
                            <span class="navbar-link-mask inline-block overflow-hidden">
                                <span class="navbar-link-inner inline-block">
                                    {link.label}
                                </span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<noscript>
    <style>
        .site-header {
            opacity: 1 !important;
            transform: none !important;
        }
    </style>
</noscript>

<script>
    import { animate, stagger } from "motion";

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;

    const header = document.querySelector(".site-header");
    const logoLetters = document.querySelectorAll(".navbar-logo-letter");
    const linkInners = document.querySelectorAll(".navbar-link-inner");

    if (header instanceof HTMLElement) {
        if (prefersReducedMotion) {
            header.style.opacity = "1";
            header.style.transform = "none";
            logoLetters.forEach((el) => {
                if (el instanceof HTMLElement) el.style.transform = "none";
            });
            linkInners.forEach((el) => {
                if (el instanceof HTMLElement) el.style.transform = "none";
            });
        } else {
            logoLetters.forEach((el) => {
                if (el instanceof HTMLElement) {
                    el.style.transform = "translateY(100%)";
                }
            });
            linkInners.forEach((el) => {
                if (el instanceof HTMLElement) {
                    el.style.transform = "translateY(110%)";
                }
            });

            animate(
                header,
                { opacity: 1, y: 0 },
                { duration: 1.0, delay: 0.2, ease: [0.22, 1, 0.36, 1] }
            );

            if (logoLetters.length) {
                animate(
                    logoLetters,
                    { y: ["100%", "0%"] },
                    {
                        duration: 0.7,
                        delay: stagger(0.04, { startDelay: 0.35 }),
                        ease: [0.22, 1, 0.36, 1],
                    }
                );
            }

            if (linkInners.length) {
                animate(
                    linkInners,
                    { y: ["110%", "0%"] },
                    {
                        duration: 0.7,
                        delay: stagger(0.08, { startDelay: 0.55 }),
                        ease: [0.22, 1, 0.36, 1],
                    }
                );
            }
        }
    }
</script>
