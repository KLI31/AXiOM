---
import "@fontsource-variable/dm-sans/wght.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    footerWordmark?: boolean;
    title?: string;
}

const { footerWordmark = true, title = "Axiom" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" href="/favicon-32x32.png" sizes="32" />
        <link rel="icon" href="/favicon-16x16.png" sizes="16" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="bg-background text-text">
        <Navbar />
        <main>
            <slot />
        </main>
        <Footer showWordmark={footerWordmark} />

        <script>
            import { inView, animate } from "motion";

            const prefersReducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            ).matches;

            function initChatScrollReveal() {
                const blocks = document.querySelectorAll("main > *");
                if (!blocks.length) return;

                blocks.forEach((block, index) => {
                    if (!(block instanceof HTMLElement)) return;

                    // The first block is treated as the hero/splash section;
                    // it usually has its own entrance animation, so we leave
                    // it untouched to avoid conflicting motion.
                    if (index === 0) return;

                    if (prefersReducedMotion) {
                        block.style.opacity = "1";
                        return;
                    }

                    const staggerDelay = Math.min(index * 0.05, 0.15);

                    block.style.willChange = "transform, opacity";
                    block.style.opacity = "0";
                    block.style.transform = "translateY(24px) scale(0.99)";

                    inView(
                        block,
                        (element) => {
                            const animation = animate(
                                element,
                                {
                                    opacity: 1,
                                    y: 0,
                                    scale: 1,
                                },
                                {
                                    duration: 0.7,
                                    delay: staggerDelay,
                                    ease: [0.22, 1, 0.36, 1],
                                }
                            );

                            animation.then(() => {
                                element.style.willChange = "auto";
                            });
                        },
                        {
                            margin: "-12% 0px -18% 0px",
                            amount: 0.2,
                        }
                    );
                });
            }

            initChatScrollReveal();
        </script>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        scroll-behavior: smooth;
        font-family: "DM Sans Variable", system-ui, sans-serif;
        scrollbar-width: none;
    }
</style>
