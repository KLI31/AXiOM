{
    "$schema": "https://opencode.ai/config.json",
    "formatter": {
        "eslint": {
            "command": ["pnpm", "exec", "eslint", "--fix", "$FILE"],
            "extensions": [
                ".js",
                ".jsx",
                ".ts",
                ".tsx",
                ".astro",
                ".mjs",
                ".cjs"
            ]
        },
        "prettier": {
            "extensions": [
                ".js",
                ".jsx",
                ".ts",
                ".tsx",
                ".astro",
                ".mjs",
                ".cjs",
                ".json",
                ".md",
                ".css"
            ]
        }
    }
}
